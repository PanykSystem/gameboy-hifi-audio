# sdkconfig defaults. PlatformIO picks this up automatically when present.

# Bluetooth: classic (A2DP) plus BLE (the web config server).
# The controller runs in BTDM dual mode so the BLE GATT config server runs
# alongside the A2DP source. To build classic-only, set BT_BLE_ENABLED=n and the
# CTRL_MODE choice back to BR_EDR_ONLY, then delete sdkconfig.esp32dev. bt_a2d.c
# keys off CONFIG_BT_BLE_ENABLED and rebuilds unchanged.
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SPP_ENABLED=n
CONFIG_BT_BLE_ENABLED=y

# BTDM controller mode must match what we enable at runtime
# (esp_bt_controller_enable in bt_a2d.c). BR_EDR_ONLY is classic only; BTDM is
# dual. The IDF default BLE_ONLY makes esp_bt_controller_enable(CLASSIC_BT) fail
# with INVALID_ARG.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=y

# Run the BLE GATT config server alongside the A2DP source. Needs BT_BLE_ENABLED.
CONFIG_GBHIFI_BLE_CONFIG=y

# Pin the BT controller task to core 1 (IDF default: core 0). With everything
# Bluetooth on core 0, A2DP streaming saturates it (top: controller 28% + BTC/SBC
# encode 43% + BTU 18% + HCI 8% = 98%, IDLE0 pegged at 0) and BTC -- the
# lowest-priority BT task, the one doing the SBC encode -- comes up ~3 ms short
# per second. The encoder then under-delivers media (~94% of 44.1 kHz measured by
# RTP timestamp advance vs wall clock) and the sink inserts ~150 ms of silence
# every ~2 s to re-sync: the "choppy Bluetooth" symptom. Moving the controller's
# 28% to core 1 gives BTC the headroom on core 0; core 1 affords it because the
# pipeline now skips the local DSP path while a sink streams (the local outputs
# are muted/suspended for the whole stream -- see audio_pipeline.c).
CONFIG_BTDM_CTRL_PINNED_TO_CORE_1=y

# Power management. Tickless idle (automatic light sleep) deschedules the audio
# pipeline task long enough to underrun the A2DP stream and garble Bluetooth, so
# it stays off. PM_ENABLE stays on for DFS and BT controller modem-sleep, which
# carry the streaming-power savings; disabling PM entirely boot-loops.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n
# Per-task run-time stats (console `top`) stay OFF in production builds: the
# counters hook every context switch on both cores, and during A2DP streaming
# core 0 (controller + HCI + BTU + SBC encode in BTC) runs ~97% loaded with a
# context-switch storm -- the per-switch overhead starved BTC_TASK and chopped
# the stream (task_wdt on IDLE0 confirmed the saturation). Uncomment all three
# to diagnose CPU use on the bench; `top` compiles out cleanly without them and
# the cheap per-block `load` command still works.
# CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
# CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Task watchdog: do NOT watch the core-0 idle task. When the whole Bluetooth
# stack lived on core 0, A2DP streaming legitimately left that core with no idle
# time; the watchdog treated it as a hang and, on this IDF, printed six lines
# plus a full backtrace over a 115200 UART from a high-priority context -- a
# blocking stall long enough to starve the I2S DMA, audible as a chop every 5 s
# on BOTH outputs. With the controller now on core 1, core 0 idles ~40% even
# while streaming, but connect/pairing bursts can still peg it transiently, so
# the watch stays off. Watching core 1 (audio task + controller) is kept: a
# stall there is a real fault.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# Compile at -O2, not the IDF default -Og. Measured on the bench (2026-08-14,
# A2DP streaming + BLE spectrum at 80 MHz): under -Og the audio task ran at 85%
# of its 5.8 ms block budget with 29% of blocks over -- float biquads at ~37
# cycles/sample and the plain-C wrapper loops far worse, so enabling the BT EQ
# (95% avg) audibly chopped. The work is CPU-bound (scales ~2x at 160 MHz), and
# -Og is simply bad codegen for FPU loops on Xtensa. -O2 buys the headroom that
# keeps EQ + NR + visualizer inside the budget at 80 MHz.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# CPU at 80 MHz. The DSP load is light and this saves about 20 mA versus 240 MHz.
# Verified 2026-08-13: the audio task runs at ~42% of one core here with the
# reconstruction filter on, and raising the clock to 240 MHz does not change the
# dropouts heard while a BLE config client is connected, so the clock is not the
# constraint.
CONFIG_ESP32_DEFAULT_CPU_FREQ_80=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# Flash size (IDF default is 2 MB).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Custom partition table (nvs / otadata / phy_init / ota_0 / ota_1 / storage).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Firmware version, shown in the web UI via the OTA GET_INFO reply and at boot.
# Pinned here rather than from git-describe. Keep it in lockstep with the release
# tag (minus the leading 'v'): bump this, delete sdkconfig.esp32dev, rebuild.
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.3.0"

# OTA rollback / anti-brick. A freshly OTA'd image boots in PENDING_VERIFY; main.c
# marks it valid once init completes, so an image that panics during init is
# reverted to the previous slot by the bootloader on the next reset. This is not
# anti-rollback / secure-version, which is a separate secure-boot feature.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Interrupt watchdog at 2000 ms (IDF default 300 ms). A marginal I2C bus can make
# the driver run its bus-recovery long enough to trip the 300 ms watchdog; the
# longer window lets recovery finish and surface as a logged error instead of a
# crash.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=2000

# The per-second ADC peak log lives behind CONFIG_GBHIFI_DEBUG_PEAK_LOG, off by
# default. Enable it in a local build when trimming gain or chasing clock drift.

# Skip boot-time RF calibration and run from the NVS-stored calibration data.
# The default partial calibration TXes through the radio inside esp_phy_enable
# -- the single largest boot current spike. On a low battery (VIN ~2.4 V) that
# spike sags the boost rail below the brownout threshold and the board
# boot-loops at BT bring-up. Stored data is refreshed whenever a full cal runs
# (first boot after flash erase), so steady-state RF performance is unchanged;
# the trade is losing the per-boot temperature touch-up, fine at BT-headphone
# range. main.c's brownout loop breaker is the backstop, not the fix.
CONFIG_ESP_PHY_RF_CAL_NONE=y
